# video-cut configuration
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# All keys carry the VIDEO_CUT_ prefix: only prefixed variables are read,
# so unrelated exports in your shell (OSS_*, DASHSCOPE_API_KEY) cannot
# interfere with this tool.

# --- DashScope (ASR + LLM) ---
# API key from https://bailian.console.aliyun.com/
VIDEO_CUT_DASHSCOPE_API_KEY=

# --- Aliyun OSS (audio staging for ASR) ---
VIDEO_CUT_OSS_BUCKET=
# e.g. https://oss-cn-shanghai.aliyuncs.com (https required: DashScope
# refuses to pull plain-http URLs)
VIDEO_CUT_OSS_ENDPOINT=
VIDEO_CUT_OSS_ACCESS_KEY_ID=
VIDEO_CUT_OSS_ACCESS_KEY_SECRET=

# --- Models (defaults shown; override only if needed) ---
VIDEO_CUT_ASR_MODEL=paraformer-v2
VIDEO_CUT_LLM_MODEL=qwen-max
