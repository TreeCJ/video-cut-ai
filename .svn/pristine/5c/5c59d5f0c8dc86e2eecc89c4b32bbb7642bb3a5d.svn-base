"""Cutting highlights into clips and merging them via ffmpeg.

Each Highlight is re-encoded on its own with uniform parameters (libx264,
yuv420p, CFR 30fps, resolution capped at 1080p keeping aspect ratio, AAC
48kHz stereo) so the clips can later be joined with the concat demuxer and
stream copy — the merge itself never re-encodes.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import tempfile
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from pathlib import Path
from typing import Any

# Uniform segment encoding parameters (spec: 切片与合并).
SEGMENT_FPS = 30
SEGMENT_MAX_WIDTH = 1920
SEGMENT_MAX_HEIGHT = 1080
SEGMENT_AUDIO_SAMPLE_RATE_HZ = 48000
SEGMENT_AUDIO_CHANNELS = 2

DEFAULT_CONCURRENCY = os.cpu_count() or 1

_UNSAFE_FILENAME_CHARS = re.compile(r'[\\/:*?"<>|\x00-\x1f]')


@dataclass(frozen=True)
class Highlight:
    """One highlight segment from highlights.json (seconds)."""

    title: str
    reason: str
    quote: str
    start: float
    end: float

    @classmethod
    def from_dict(cls, item: Any, context: str) -> Highlight:
        """Validate one highlight mapping against the contract.

        ``context`` labels the entry in error messages (e.g. the source file
        plus its 1-based index). Raises ValueError on any contract breach;
        callers wrap it in their own error type.
        """
        try:
            highlight = cls(
                title=str(item["title"]),
                reason=str(item["reason"]),
                quote=str(item["quote"]),
                start=float(item["start"]),
                end=float(item["end"]),
            )
        except (KeyError, TypeError, ValueError) as error:
            raise ValueError(f"{context} is invalid: {error}") from error
        if highlight.end <= highlight.start:
            raise ValueError(f"{context} ({highlight.title!r}) has end <= start.")
        return highlight


def load_highlights(highlights_path: Path) -> list[Highlight]:
    """Load and validate highlights.json."""
    raw = json.loads(highlights_path.read_text(encoding="utf-8"))
    if not isinstance(raw, list):
        raise ValueError(f"{highlights_path} must contain a JSON list of highlights.")
    return [
        Highlight.from_dict(item, f"{highlights_path} entry {index + 1}")
        for index, item in enumerate(raw)
    ]


def clip_filename(index: int, title: str) -> str:
    """Build a clip filename like '01-opening-hook.mp4'."""
    safe_title = _UNSAFE_FILENAME_CHARS.sub("-", title).strip()
    return f"{index:02d}-{safe_title}.mp4"


def cut_segment(video_path: Path, highlight: Highlight, clip_path: Path) -> None:
    """Re-encode one highlight range into a uniform-parameter mp4 clip.

    Frame-accurate: -ss before -i seeks fast, and since we re-encode, the
    cut point lands exactly on the requested timestamp.
    """
    scale_filter = (
        f"scale=w='min(iw,{SEGMENT_MAX_WIDTH})'"
        f":h='min(ih,{SEGMENT_MAX_HEIGHT})'"
        ":force_original_aspect_ratio=decrease"
        ":force_divisible_by=2"
    )
    
    cmd = [
        "ffmpeg",
        "-y",
        "-ss",
        str(highlight.start),
        "-to",
        str(highlight.end),
        "-i",
        str(video_path),
        "-vf",
        scale_filter,
        "-r",
        str(SEGMENT_FPS),
        "-c:v",
        "libx264",
        "-pix_fmt",
        "yuv420p",
        "-c:a",
        "aac",
        "-ar",
        str(SEGMENT_AUDIO_SAMPLE_RATE_HZ),
        "-ac",
        str(SEGMENT_AUDIO_CHANNELS),
        str(clip_path),
    ]
    
    try:
        subprocess.run(
            cmd,
            check=True,
            capture_output=True,
            text=True,
        )
    except subprocess.CalledProcessError as error:
        # Provide detailed error information for debugging
        error_msg = (
            f"ffmpeg failed cutting '{highlight.title}' ({highlight.start:.2f}s - {highlight.end:.2f}s)\n"
            f"Command: {' '.join(cmd)}\n"
            f"Exit code: {error.returncode}\n"
        )
        if error.stderr:
            # Extract last few lines of stderr for context
            stderr_lines = error.stderr.strip().split('\n')
            error_msg += f"ffmpeg stderr (last 10 lines):\n" + '\n'.join(stderr_lines[-10:])
        if error.stdout:
            stdout_lines = error.stdout.strip().split('\n')
            error_msg += f"\nffmpeg stdout (last 10 lines):\n" + '\n'.join(stdout_lines[-10:])
        
        # Check if input file exists
        if not video_path.exists():
            error_msg += f"\nInput file does not exist: {video_path}"
        elif video_path.stat().st_size == 0:
            error_msg += f"\nInput file is empty: {video_path}"
            
        raise RuntimeError(error_msg) from error


def merge_segments(clip_paths: list[Path], merged_path: Path) -> None:
    """Concatenate clips with the concat demuxer + stream copy (no re-encode)."""
    with tempfile.NamedTemporaryFile(
        mode="w", suffix=".txt", delete=False, encoding="utf-8"
    ) as concat_file:
        for clip_path in clip_paths:
            escaped = str(clip_path.resolve()).replace("'", "'\\''")
            concat_file.write(f"file '{escaped}'\n")
        concat_list = concat_file.name
    try:
        subprocess.run(
            [
                "ffmpeg",
                "-y",
                "-f",
                "concat",
                "-safe",
                "0",
                "-i",
                concat_list,
                "-c",
                "copy",
                str(merged_path),
            ],
            check=True,
            capture_output=True,
            text=True,
        )
    finally:
        Path(concat_list).unlink(missing_ok=True)


def cut_highlights(
    video_path: Path,
    highlights: list[Highlight],
    clips_dir: Path,
    concurrency: int = DEFAULT_CONCURRENCY,
) -> list[Path]:
    """Cut all highlights in parallel; returns clip paths in highlight order."""
    clips_dir.mkdir(parents=True, exist_ok=True)
    clip_paths = [
        clips_dir / clip_filename(index, highlight.title)
        for index, highlight in enumerate(highlights, start=1)
    ]
    # ThreadPoolExecutor bounds concurrency to `concurrency` workers (the
    # semaphore): ffmpeg subprocesses are I/O-bound on the GIL, so threads
    # suffice.
    with ThreadPoolExecutor(max_workers=concurrency) as pool:
        futures = [
            pool.submit(cut_segment, video_path, highlight, clip_path)
            for highlight, clip_path in zip(highlights, clip_paths)
        ]
        for future in futures:
            future.result()
    return clip_paths
