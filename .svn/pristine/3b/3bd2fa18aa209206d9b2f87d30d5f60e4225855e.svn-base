<ol class="step-strip" id="steps"
    data-stem="{{ stem }}" data-task-running="{{ 'true' if task_running else 'false' }}">
  {% set step_labels = {'extract-audio': '提取音频', 'transcribe': '语音转录', 'analyze': '高光分析', 'cut': '视频剪辑'} %}
  {% for step in steps %}
  <li class="step-item" id="step-{{ step.name }}" data-step="{{ step.name }}">
    <span class="status-dot status-{{ step.status }}"></span>
    <span class="step-name">{{ step_labels.get(step.name, step.name) }}</span>
    {% if step.detail %}<span class="detail">{{ step.detail }}</span>{% endif %}
    {% if step.error %}
    <pre class="error-summary">{{ step.error }}</pre>
    {% endif %}
    {% if step.name != "cut" %}
    <details class="step-controls">
      <summary>单步</summary>
      {% include "step_card.html" %}
    </details>
    {% endif %}
  </li>
  {% endfor %}
</ol>
