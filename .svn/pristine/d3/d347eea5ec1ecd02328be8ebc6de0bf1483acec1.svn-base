{% extends "base.html" %}
{% block title %}视频库 · 镜头台{% endblock %}
{% block content %}
<div class="wrap">
  <div class="library-intro">
    <h1>从一段视频开始</h1>
    <p class="sub">给机器一句提示词，它抽音、转录、挑高光；你审看调整，一键出片。</p>
    <form method="post" action="/videos">
      <label for="video_path">本机视频绝对路径</label>
      <input type="text" id="video_path" name="video_path" required
             placeholder="/Users/you/Movies/talk.mp4" autofocus>
      <button class="btn btn-primary" type="submit">开始工作流</button>
    </form>
    {% if error %}
    <p class="error">{{ error }}</p>
    {% endif %}
  </div>

  {% if entries %}
  <ul class="library">
    {% for entry in entries %}
    <li class="{% if not entry.source_exists %}missing{% endif %}">
      {% if entry.source_exists %}
      <a href="/videos/{{ entry.stem }}">{{ entry.stem }}</a>
      <span class="path">{{ entry.source_path }}</span>
      {% else %}
      <span>{{ entry.stem }}</span>
      <span class="path">{{ entry.source_path }}</span>
      <span class="badge">源文件缺失</span>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="library-empty">还没有处理过的视频。</p>
  {% endif %}
</div>
{% endblock %}
