{% extends "base.html" %}
{% block title %}{{ stem }} · 镜头台{% endblock %}
{% block topbar_meta %}{{ stem }} · {{ source_path }}{% endblock %}

{% block head %}
<style>
  /* ── 三幕工作台 ───────────────────────────────────── */
  .acts { display: flex; flex-direction: column; gap: 26px; }
  .act { display: flex; gap: 20px; }
  .act-rail {
    flex: none; width: 128px; padding-top: 3px;
    display: flex; flex-direction: column; gap: 5px;
  }
  .act-no { font-family: var(--mono); font-size: 11px; letter-spacing: 0.25em; color: var(--ink-faint); }
  .act-title { font-size: 21px; font-weight: 700; letter-spacing: 0.01em; }
  .act-sub { color: var(--ink-dim); font-size: 12.5px; }
  .act-state { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--ink-dim); margin-top: 3px; }
  .act-state .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ink-faint); flex: none; }
  .act-body { flex: 1; min-width: 0; }
  .field {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--r);
    padding: 18px;
  }

  /* ── 第一幕：生成 ─────────────────────────────────── */
  .field-prompt { max-width: 620px; }
  .prompt-row { display: flex; gap: 10px; align-items: flex-start; }
  .prompt-row textarea { flex: 1; }
  .act-state.s-done .dot { background: var(--ok); }
  .act-state.s-current .dot { background: var(--accent); box-shadow: 0 0 8px var(--accent-line); }
  .act-state.s-failed .dot { background: var(--danger); }

  /* ── 第二幕：审看 ─────────────────────────────────── */
  .field-look { padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); }
  .stage { position: relative; background: #000; border-radius: var(--r) var(--r) 0 0; overflow: hidden; }
  .stage video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; }
  .stage .tc-now {
    position: absolute; right: 10px; top: 10px;
    background: rgba(9, 10, 11, 0.72); padding: 3px 8px; border-radius: 5px;
    color: var(--ink); font-size: 12px; letter-spacing: 0.04em;
  }
  .stage .tc-range {
    position: absolute; left: 10px; top: 10px;
    background: rgba(9, 10, 11, 0.72); padding: 3px 8px; border-radius: 5px;
    display: flex; gap: 8px; align-items: center;
    font-family: var(--mono); font-size: 12px; color: var(--ink-dim);
  }
  .stage .tc-range .lamp { width: 8px; height: 8px; border-radius: 2px; background: var(--accent); flex: none; box-shadow: 0 0 6px var(--accent-line); }

  .filmstrip {
    position: relative; height: 34px;
    background: var(--bg-deep);
    border-top: 1px solid var(--line-soft);
    border-bottom: 1px solid var(--line-soft);
    overflow: hidden;
  }
  .filmstrip .mark {
    position: absolute; top: 0; bottom: 0;
    background: linear-gradient(to bottom, rgba(232,163,61,.10), rgba(232,163,61,.28));
    border-left: 1px solid var(--accent-line);
    border-right: 1px solid var(--accent-line);
    cursor: pointer;
  }
  .filmstrip .mark:hover { filter: brightness(1.25); }
  .filmstrip .playhead {
    position: absolute; top: 0; bottom: 0; width: 2px;
    background: #fff; box-shadow: 0 0 5px rgba(255,255,255,.7);
    pointer-events: none;
  }
  .filmstrip .dur {
    position: absolute; right: 8px; bottom: 4px;
    font-family: var(--mono); font-size: 10px; color: var(--ink-faint);
  }

  .deck { padding: 16px 18px 14px; }
  .seq-head { display: flex; align-items: baseline; gap: 10px; margin-bottom: 10px; }
  .seq-head h2 { margin: 0; font-size: 15px; font-weight: 700; letter-spacing: .02em; }
  .seq-head .budget { margin-left: auto; font-size: 12px; color: var(--ink-dim); }
  .seq-head .budget b { color: var(--accent); font-family: var(--mono); font-weight: 600; }

  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .highlight-card {
    position: relative;
    background: var(--panel-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 14px 10px 14px;
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    gap: 4px 12px;
    transition: border-color .15s, background .15s;
  }
  .highlight-card:hover { border-color: #34363c; }
  .highlight-card.locked { border-color: var(--accent-line); }
  .highlight-card .idx { grid-row: 1 / span 4; align-self: start; padding-top: 2px; }
  .idx-chip {
    font-family: var(--mono); font-size: 12px; color: var(--ink-faint);
    border: 1px solid var(--line); border-radius: 6px;
    width: 30px; height: 30px; display: grid; place-items: center;
  }
  .highlight-card.locked .idx-chip { border-color: var(--accent-line); color: var(--accent); }
  .clip-title { font-weight: 600; font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .lock-badge {
    display: inline-block; margin-left: 6px;
    font-size: 11px; color: var(--accent); font-weight: 500;
    border: 1px solid var(--accent-line); border-radius: 4px; padding: 0 6px;
    vertical-align: 2px;
  }
  .card-actions { display: flex; gap: 6px; }
  .card-actions button {
    font-size: 12px; font-weight: 500;
    background: transparent; color: var(--ink-dim);
    border: 1px solid var(--line); border-radius: 6px;
    padding: 3px 10px; cursor: pointer;
    transition: color .15s, border-color .15s, background .15s;
  }
  .card-actions .preview { color: var(--accent); border-color: var(--accent-line); }
  .card-actions .preview:hover { background: var(--accent-soft); }
  .card-actions button:hover { color: var(--ink); border-color: #3a3d44; background: #22242a; }
  .card-actions button[disabled] { opacity: .3; cursor: not-allowed; }
  .reason { margin: 0; grid-column: 2 / 4; color: var(--ink-dim); font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .time-range { margin: 0; grid-column: 2 / 4; display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .bound { display: inline-flex; align-items: baseline; gap: 6px; font-size: 12px; color: var(--ink-dim); }
  .bound .k {
    font-family: var(--mono); font-size: 10px; letter-spacing: .1em; color: var(--ink-faint);
    border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px;
  }
  .bound .v { color: var(--ink); }
  .bound { align-items: center; }
  .nudge {
    width: 20px; height: 20px; line-height: 1; padding: 0; cursor: pointer;
    font-family: var(--mono); font-size: 12px; color: var(--ink-dim);
    border: 1px solid var(--line); border-radius: 4px; background: transparent;
  }
  .nudge:hover { color: var(--ink); border-color: #3a3d44; background: #22242a; }
  .nudge:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .time-range .duration { margin-left: auto; color: var(--ink-faint); font-size: 12px; }

  /* 叠加式双滑杆 + 琥珀选段 */
  .hs { grid-column: 2 / 4; margin-top: 4px; height: 26px; position: relative; }
  .hs input[type="range"] {
    position: absolute; margin: 0; width: 100%; height: 26px;
    -webkit-appearance: none; background: transparent; cursor: pointer; pointer-events: none;
  }
  .hs input[type="range"]::-webkit-slider-thumb { pointer-events: auto; }
  .hs input[type="range"]::-moz-range-thumb { pointer-events: auto; }
  .hs input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 12px; height: 20px; border-radius: 4px;
    background: #0e0f11; border: 1px solid var(--accent);
    box-shadow: 0 1px 4px rgba(0,0,0,.5);
  }
  .hs input[type="range"]::-moz-range-thumb {
    width: 12px; height: 20px; border-radius: 4px;
    background: #0e0f11; border: 1px solid var(--accent);
    box-shadow: 0 1px 4px rgba(0,0,0,.5);
  }
  .hs .rail { position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: var(--line); border-radius: 1px; }
  .hs .sel {
    position: absolute; top: 50%; height: 4px; margin-top: -2px;
    background: var(--accent-line); border-radius: 2px; pointer-events: none;
  }
  .hs .hs-hint {
    position: absolute; right: 0; top: -13px;
    font-size: 10px; color: var(--ink-faint); font-family: var(--mono);
    opacity: 0; transition: opacity .15s;
  }
  .highlight-card:hover .hs-hint { opacity: .8; }

  /* ── 转录 ─────────────────────────────────────────── */
  .transcript-wrap { margin: 6px 0 0; }
  .transcript-toggle {
    background: none; border: none; cursor: pointer;
    color: var(--ink-dim); font-size: 12.5px; font-family: var(--sans);
    padding: 4px 0; display: inline-flex; align-items: center; gap: 6px;
  }
  .transcript-toggle:hover { color: var(--ink); }
  .transcript-toggle .chev { transition: transform .2s; font-size: 10px; color: var(--ink-faint); }
  .transcript-wrap.open .transcript-toggle .chev { transform: rotate(90deg); }
  .transcript { display: none; margin-top: 6px; max-height: 180px; overflow-y: auto; border-left: 2px solid var(--line); padding-left: 12px; }
  .transcript-wrap.open .transcript { display: block; }
  .sentence-list { list-style: none; padding: 0; margin: 0; }
  .sentence { display: flex; gap: 10px; padding: 2px 0; font-size: 12.5px; color: var(--ink-dim); }
  .sentence:hover { color: var(--ink); }
  .timecode {
    border: none; background: none; padding: 0; cursor: pointer;
    color: var(--accent); font-family: var(--mono); font-size: 11px;
    min-width: 3.5rem; text-align: right;
  }
  .timecode:hover { text-decoration: underline; }
  .sentence-text { flex: 1; }

  .highlights-empty { color: var(--ink-faint); margin: 8px 0 0; }

  /* ── 第三幕：出片 ─────────────────────────────────── */
  .field-master { padding: 0; display: grid; grid-template-columns: minmax(0, 1fr) 280px; }
  .master-stage { background: #000; border-radius: var(--r) 0 0 var(--r); overflow: hidden; position: relative; }
  .master-stage video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; }
  .master-side { border-left: 1px solid var(--line); display: flex; flex-direction: column; }
  .master-side .head { padding: 14px 16px 10px; border-bottom: 1px solid var(--line-soft); }
  .master-side .head h2 { margin: 0 0 2px; font-size: 14px; }
  .master-side .head .sub { color: var(--ink-faint); font-size: 12px; }
  .master-list { flex: 1; overflow-y: auto; max-height: 300px; }
  .master-item {
    display: flex; gap: 8px; align-items: center;
    padding: 8px 16px; font-size: 12.5px; color: var(--ink-dim);
    border-bottom: 1px solid var(--line-soft);
  }
  .master-item .no { font-family: var(--mono); font-size: 11px; color: var(--ink-faint); flex: none; width: 22px; }
  .master-item .t { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .master-item .d { font-family: var(--mono); font-size: 11px; color: var(--ink-faint); }
  .master-foot { padding: 12px 16px; border-top: 1px solid var(--line-soft); }
  .master-foot .stat { display: flex; justify-content: space-between; font-size: 12px; color: var(--ink-dim); margin-bottom: 12px; }
  .master-foot .stat b { color: var(--ink); font-family: var(--mono); font-weight: 600; }
  .master-foot .btn { width: 100%; text-align: center; font-size: 15px; padding: 12px 0; }
  .master-empty { padding: 28px 20px; text-align: center; color: var(--ink-faint); font-size: 12.5px; }
  .final-cut .rl { display: flex; align-items: center; gap: 8px; color: var(--accent); font-size: 13px; padding: 18px 16px; }
  .final-cut .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); animation: pulse 1.1s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .25; } }
  .final-cut { display: grid; grid-template-columns: minmax(0, 1fr) 280px; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r); }
  .final-cut .stage { border-radius: var(--r) 0 0 var(--r); }
  #final-cut { min-height: 220px; }

  /* 对齐报告（swap 目标 #cut-report / #final-cut 内嵌）*/
  .cut-report { padding: 18px; }
  .cut-report table { width: 100%; border-collapse: collapse; font-size: 12.5px; margin: 10px 0 14px; }
  .cut-report th { text-align: left; color: var(--ink-faint); font-weight: 500; font-size: 11.5px; border-bottom: 1px solid var(--line); padding: 4px 8px; }
  .cut-report td { border-bottom: 1px solid var(--line-soft); padding: 5px 8px; color: var(--ink-dim); }
  .cut-report tr.locked td { color: var(--accent); }
  .cut-report tr.moved td { color: var(--ink); }
  .cut-report .warning-row td { color: var(--danger); font-size: 11.5px; }
  .cut-progress { padding: 18px; }

  .artifacts { grid-column: 1 / 3; border-top: 1px solid var(--line); }
  .artifacts h3 { margin: 0; padding: 12px 16px 0; font-size: 13px; color: var(--ink-dim); }
  .clip-list { list-style: none; margin: 0; padding: 8px 16px 12px; display: flex; gap: 10px; overflow-x: auto; }
  .clip { flex: none; width: 200px; }
  .clip video { width: 100%; border-radius: 6px; background: #000; display: block; }
  .clip-name { font-size: 11px; color: var(--ink-faint); font-family: var(--mono); display: block; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* ── 等待反馈：按钮 loading 态 + toast ───────────── */
  .btn[data-loading] { display: inline-flex; align-items: center; gap: 9px; }
  .btn[data-loading] .spinner {
    width: 14px; height: 14px; border-radius: 50%; flex: none;
    border: 2px solid rgba(22, 16, 6, 0.35); border-top-color: var(--on-accent);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .btn[data-loading] .timer { font-family: var(--mono); font-size: 12.5px; font-weight: 500; }
  .toast {
    position: fixed; right: 20px; bottom: 20px; z-index: 90;
    background: var(--panel-raised); border: 1px solid var(--accent-line);
    border-radius: 10px; padding: 12px 18px;
    color: var(--ink); font-size: 13.5px; font-weight: 500;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    opacity: 0; transform: translateY(8px); pointer-events: none;
    transition: opacity .25s, transform .25s;
  }
  .toast.show { opacity: 1; transform: translateY(0); }

  /* ── 小屏 ─────────────────────────────────────────── */
  @media (max-width: 860px) {
    .act { flex-direction: column; gap: 10px; }
    .act-rail { width: auto; flex-direction: row; align-items: baseline; gap: 12px; flex-wrap: wrap; }
    .act-no { display: none; }
    .field-master, .final-cut { grid-template-columns: 1fr; }
    .final-cut .stage, .master-stage { border-radius: var(--r) var(--r) 0 0; }
    .master-side, .final-cut aside { border-left: none; border-top: 1px solid var(--line); }
    .artifacts { grid-column: 1; }
  }
</style>
{% endblock %}

{% block content %}
<div class="wrap" data-video-duration="{{ video_duration or 0 }}" data-highlight-count="{{ highlights|length }}">
<div class="acts">

  <!-- ═══ 第一幕 · 生成 ═══ -->
  <section class="act" id="act-generate">
    <div class="act-rail">
      <span class="act-no">ACT 01</span>
      <span class="act-title">生成高光</span>
      <span class="act-sub">提示词 → 高光序列</span>
      <span class="act-state {{ 's-done' if highlights else 's-current' }}">
        <span class="dot"></span>{{ '已完成' if highlights else '待生成' }}
      </span>
    </div>
    <div class="act-body">
      <div class="field field-prompt">
        <form hx-post="/videos/{{ stem }}/analyze"
              hx-target="#steps" hx-swap="outerHTML">
          <div class="prompt-row">
            <textarea name="prompt" rows="3"
                      placeholder="一句话告诉机器你想找什么：找反转和笑点 / 提炼人物主线 / 只保留情绪峰值……">{{ analyze_prompt or "" }}</textarea>
            {% if highlights %}
            <input type="hidden" name="force" value="true">
            {% endif %}
            <button class="btn btn-primary" type="submit" data-loading-trigger
                    data-loading-label="AI 分析中" {% if task_running %}disabled{% endif %}>
              {{ '重新生成' if highlights else '生成高光' }}
            </button>
          </div>
          <p class="error" id="trigger-error" data-error-slot style="margin: 8px 0 0;"></p>
        </form>
        <p class="hint">首次自动完成 抽音 → 转录 → 选题；重新生成只重跑选题，保留现有转录。</p>
        {% include "step_strip.html" %}
      </div>
    </div>
  </section>

  <!-- ═══ 第二幕 · 审看 ═══ -->
  <section class="act" id="act-review">
    <div class="act-rail">
      <span class="act-no">ACT 02</span>
      <span class="act-title">审看与调整</span>
      <span class="act-sub">预览 · 打点 · 增删排序</span>
      <span class="act-state {{ 's-current' if highlights else '' }}">
        <span class="dot"></span>{{ '进行中' if highlights else '待高光' }}
      </span>
    </div>
    <div class="act-body">
      <div class="field field-look">
        {% if source_available %}
        <div class="stage">
          <video id="source-video" controls preload="metadata"
                 src="/videos/{{ stem }}/source"></video>
          <div class="tc-now mono" id="tc-now">00:00.0</div>
        </div>
        <div class="filmstrip" id="filmstrip" aria-hidden="true">
          <span class="playhead" id="playhead"></span>
          <span class="dur mono">总长 {{ "%.0f"|format(video_duration) if video_duration else "–" }}s</span>
        </div>
        {% else %}
        <p class="hint" style="padding: 18px;">源视频文件缺失：{{ source_path }}</p>
        {% endif %}

        <div class="deck">
          {% if highlights %}
          {% include "highlight_cards.html" %}
          {% else %}
          <section class="highlights" aria-label="高光序列" id="highlight-cards">
            <div class="seq-head"><h2>高光序列</h2></div>
            <p class="highlights-empty">尚无高光——在第一幕输入提示词点「生成高光」，跑完 抽音 → 转录 → 选题 后出现。</p>
          </section>
          {% endif %}

          {% if sentences %}
          <div class="transcript-wrap" id="transcript-wrap">
            <button class="transcript-toggle" type="button" data-transcript-toggle>
              <span class="chev">▶</span>全片转录（{{ sentences|length }} 句）
            </button>
            <ol class="transcript sentence-list">
              {% for sentence in sentences %}
              <li class="sentence">
                <button type="button" class="timecode"
                        data-begin-time="{{ sentence.begin_time }}">{{ "%.1f"|format(sentence.begin_time) }}s</button>
                <span class="sentence-text">{{ sentence.text }}</span>
              </li>
              {% endfor %}
            </ol>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 第三幕 · 出片 ═══ -->
  <section class="act" id="act-master">
    <div class="act-rail">
      <span class="act-no">ACT 03</span>
      <span class="act-title">剪切合并</span>
      <span class="act-sub">一键成片 · 预览</span>
      <span class="act-state {{ 's-done' if merged_available else ('' if highlights else '') }}">
        <span class="dot"></span>{{ '已出片' if merged_available else '待出片' }}
      </span>
    </div>
    <div class="act-body">
      <section class="final-cut" aria-label="最终切片合并" id="final-cut">
        <p class="error" id="cut-error" data-error-slot style="grid-column: 1/3; margin: 0; padding: 10px 16px 0;"></p>
        {% if highlights %}
        <div class="stage">
          {% if merged_available %}
          <video id="merged-video" controls preload="metadata"
                 src="/videos/{{ stem }}/merged"></video>
          {% endif %}
        </div>
        <aside class="master-side">
          <div class="head">
            <h2>成品清单</h2>
            <div class="sub">{{ clips|length }} 段{% if merged_available %} · merged.mp4 已就绪{% endif %}</div>
          </div>
          <div class="master-list">
            {% if clips %}
            {% for clip in clips %}
            <div class="master-item">
              <span class="no">{{ loop.index }}</span>
              <a class="t" href="/videos/{{ stem }}/clips/{{ clip }}" target="_blank">{{ clip }}</a>
            </div>
            {% endfor %}
            {% else %}
            <p class="master-empty">尚未出片。</p>
            {% endif %}
          </div>
          <div class="master-foot">
            <div class="stat">
              <span>片段 <b>{{ clips|length }}</b></span>
              <span>总时长 <b>{{ "%.1f"|format(total_duration) }}s</b></span>
            </div>
            <form hx-post="/videos/{{ stem }}/cut"
                  hx-target="#final-cut" hx-swap="outerHTML">
              <button class="btn btn-primary" type="submit" {% if task_running %}disabled{% endif %}>
                {{ '重新剪切合并' if merged_available else '一键剪切合并' }}
              </button>
            </form>
            <p class="hint">统一重编码（CFR 30fps · ≤1080p · AAC 48kHz）后无损拼接。</p>
          </div>
        </aside>
        {% if clips or merged_available %}
        <div class="artifacts">
          <h3>切片产物</h3>
          <ol class="clip-list">
            {% for clip in clips %}
            <li class="clip">
              <span class="clip-name">{{ clip }}</span>
              <video controls preload="metadata"
                     src="/videos/{{ stem }}/clips/{{ clip }}"></video>
            </li>
            {% endfor %}
          </ol>
        </div>
        {% endif %}
        {% else %}
        <p class="master-empty" style="grid-column: 1/3;">先在第二幕审看高光，再出片。</p>
        {% endif %}

        {% if cut_report %}
        {% with report_items=cut_report["items"] %}
        <section class="cut-report" aria-label="对齐报告" id="cut-report"
                 style="grid-column: 1/3;">
          <h2>对齐报告</h2>
          <p class="hint">未锁定的项会按引用原句重新锚定时间；锁定的项原样采用你的边界。</p>
          <table>
            <thead>
              <tr><th>标题</th><th>状态</th><th>原边界</th><th>最终边界</th></tr>
            </thead>
            <tbody>
              {% for item in report_items %}
              <tr class="{% if item['locked'] %}locked{% elif item['moved'] %}moved{% endif %}">
                <td>{{ item["title"] }}</td>
                <td>
                  {% if item['locked'] %}已锁定（跳过对齐）
                  {% elif item['moved'] %}已修正
                  {% else %}未变动{% endif %}
                </td>
                <td class="mono">{{ "%.2f"|format(item["original_start"]) }}s – {{ "%.2f"|format(item["original_end"]) }}s</td>
                <td class="mono">{{ "%.2f"|format(item["final_start"]) }}s – {{ "%.2f"|format(item["final_end"]) }}s</td>
              </tr>
              {% if item["warning"] %}
              <tr class="warning-row"><td colspan="4">{{ item["warning"] }}</td></tr>
              {% endif %}
              {% endfor %}
            </tbody>
          </table>
          <form hx-post="/videos/{{ stem }}/cut"
                hx-target="#cut-report" hx-swap="outerHTML">
            <button class="btn btn-primary" type="submit" name="confirm" value="true">确认剪切合并</button>
          </form>
        </section>
        {% endwith %}
        {% endif %}
      </section>
    </div>
  </section>

</div>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
(function () {
  // 409 等错误响应：把响应体写入触发表单专属的错误槽位（analyze 表单
  // 用 #trigger-error，cut 表单用 #cut-error），找不到才弹 alert 兜底。
  document.body.addEventListener("htmx:responseError", function (event) {
    var xhr = event.detail.xhr;
    var text = xhr.responseText || "请求失败 (" + xhr.status + ")";
    var slot = null;
    var form = event.detail.elt;
    if (form && form.querySelector) {
      slot = form.querySelector("[data-error-slot]") || null;
    }
    if (!slot) slot = document.getElementById("trigger-error");
    if (!slot) slot = document.getElementById("cut-error");
    if (slot) {
      slot.textContent = text;
    } else {
      alert(text);
    }
  });
})();

(function () {
  // 等待反馈：生成高光/重新生成点击后按钮立刻进入 loading 态（spinner +
  // 已耗时计时），不等服务端 202。SSE 终态整页 reload 兜底退出。
  const SLOW_AFTER_S = 180;  // 超过 3 分钟提示用户手动刷新（SSE 可能已断）

  const stepsEl = document.getElementById("steps");
  const button = document.querySelector("[data-loading-trigger]");
  if (!button || !stepsEl) return;

  const idleLabel = button.textContent;

  function fmt(sec) {
    if (sec < 60) return sec + "s";
    const m = Math.floor(sec / 60), s = sec - m * 60;
    return m + "m " + (s < 10 ? "0" : "") + s + "s";
  }

  let timerId = null;
  let startAt = null;

  function enterLoading(withTimer) {
    if (button.dataset.loading !== undefined) return;
    button.dataset.loading = "";
    button.disabled = true;
    const label = button.dataset.loadingLabel || "处理中";
    const row = document.createElement("span");
    row.innerHTML =
      '<span class="spinner" aria-hidden="true"></span><span class="btn-label"></span>' +
      (withTimer ? '<span class="timer"></span>' : "");
    button.replaceChildren(row);
    button.querySelector(".btn-label").textContent = label;
    if (!withTimer) return;
    startAt = performance.now();
    const timer = button.querySelector(".timer");
    const text = button.querySelector(".btn-label");
    timerId = setInterval(() => {
      const elapsed = Math.floor((performance.now() - startAt) / 1000);
      timer.textContent = fmt(elapsed);
      if (elapsed >= SLOW_AFTER_S) {
        text.textContent = "仍在处理，长时间无响应请刷新页面";
      }
    }, 1000);
    timer.textContent = "0s";
  }

  function exitLoading() {
    if (timerId) { clearInterval(timerId); timerId = null; }
    delete button.dataset.loading;
    button.replaceChildren(document.createTextNode(idleLabel));
  }

  // 点击瞬间进入 loading（含计时器：任务真实起点就是这次点击）。
  document.body.addEventListener("htmx:beforeRequest", (event) => {
    const form = event.detail.elt;
    if (form && form.querySelector && form.querySelector("[data-loading-trigger]") === button) {
      enterLoading(true);
    }
  });
  // 非 2xx（409 冲突等）：还原按钮，错误文案写入表单专属槽位。
  document.body.addEventListener("htmx:responseError", (event) => {
    const form = event.detail.elt;
    if (form && form.querySelector && form.querySelector("[data-loading-trigger]") === button) {
      exitLoading();
    }
  });
  // 页面加载时任务已在跑（用户手动刷新）：恢复 spinner 态，但无计时器
  // ——任务真实起点未知，从 0 计会误导。
  if (stepsEl.dataset.taskRunning === "true") {
    enterLoading(false);
  }
})();

(function () {
  // 成功 toast：SSE 收到 done 时在 sessionStorage 留标记，随后的整页
  // reload 读取标记 + 页面上的高光条数，短暂展示后清除。
  const TOAST_KEY = "video-cut:toast";
  const TOAST_MS = 2600;
  const wrap = document.querySelector(".wrap");
  const toast = document.getElementById("toast");
  if (toast && wrap && sessionStorage.getItem(TOAST_KEY) === "1") {
    sessionStorage.removeItem(TOAST_KEY);
    toast.textContent = "已生成 " + wrap.dataset.highlightCount + " 条高光";
    toast.classList.add("show");
    setTimeout(() => toast.classList.remove("show"), TOAST_MS);
  }
})();

(function () {
  const section = document.getElementById("steps");
  const stem = section.dataset.stem;
  const TOAST_KEY = "video-cut:toast";
  const source = new EventSource("/events");

  // SSE 任务结束整页 reload：三幕状态、高光卡、产物全部由服务端渲染，
  // reload 一次即可覆盖。run-to-highlights 事件的 step 不匹配任何小步，
  // 同样只在 settle 时触发 reload，不做局部 DOM 更新。
  // done 且与高光相关：先写 toast 标记再 reload（单个监听器内顺序显式）。
  source.addEventListener("task", (message) => {
    const task = JSON.parse(message.data);
    if (task.stem !== stem) return;
    if (
      task.status === "done"
      && (task.step === "analyze" || task.step === "run-to-highlights")
    ) {
      sessionStorage.setItem(TOAST_KEY, "1");
    }
    if (["done", "failed", "skipped"].includes(task.status)) {
      location.reload();
    }
  });
})();

(function () {
  const video = document.getElementById("source-video");
  if (!video) return;

  function fmtTC(sec) {
    const m = Math.floor(sec / 60), s = sec - m * 60;
    return String(m).padStart(2, "0") + ":" + (s < 10 ? "0" : "") + s.toFixed(1);
  }

  // 顶部时间码 + 胶片条播放头。
  const nowEl = document.getElementById("tc-now");
  const head = document.getElementById("playhead");
  const total = parseFloat(document.querySelector(".wrap").dataset.videoDuration || "0");
  video.addEventListener("timeupdate", () => {
    if (nowEl) nowEl.textContent = fmtTC(video.currentTime);
    if (head && total > 0) head.style.left = (video.currentTime / total * 100).toFixed(3) + "%";
  });

  // 转录句时间码点击 seek。
  document.querySelectorAll(".timecode[data-begin-time]").forEach((button) => {
    button.addEventListener("click", () => {
      video.currentTime = parseFloat(button.dataset.beginTime);
      video.play();
    });
  });

  // 胶片条：高光块 + 点击预览对应卡片。
  const strip = document.getElementById("filmstrip");
  if (strip && total > 0) {
    const draw = (ranges) => {
      strip.querySelectorAll(".mark").forEach((m) => m.remove());
      ranges.forEach((r) => {
        const mark = document.createElement("div");
        mark.className = "mark";
        mark.style.left = (r.start / total * 100).toFixed(3) + "%";
        mark.style.width = Math.max(0, (r.end - r.start) / total * 100).toFixed(3) + "%";
        mark.title = r.title;
        mark.addEventListener("click", () => {
          const card = document.getElementById("highlight-card-" + r.index);
          if (card) card.querySelector(".preview").click();
        });
        strip.appendChild(mark);
      });
    };
    // highlight_cards.html 每次渲染/重渲染都会派发当前卡片边界。
    document.addEventListener("highlights:changed", (event) => draw(event.detail));
  }
})();

(function () {
  // 转录折叠开关（details 换成 button 控制以支持动画 chev）。
  const wrap = document.getElementById("transcript-wrap");
  if (!wrap) return;
  const toggle = wrap.querySelector("[data-transcript-toggle]");
  toggle.addEventListener("click", () => wrap.classList.toggle("open"));
})();
</script>
{% endblock %}
