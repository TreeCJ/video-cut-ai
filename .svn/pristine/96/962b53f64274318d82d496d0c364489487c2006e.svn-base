# video-cut configuration
# Copy this file to `.env` and fill in your own values. Never commit `.env`.
# All keys carry the VIDEO_CUT_ prefix: only prefixed variables are read,
# so unrelated exports in your shell cannot interfere with this tool.

# --- DashScope (ASR + LLM) ---
# API key from https://bailian.console.aliyun.com/
VIDEO_CUT_DASHSCOPE_API_KEY=sk-7efc7735d4864c12bdd22c397873ea9b

# --- ASR Model Selection ---
# paraformer-realtime-v2: Real-time streaming (no OSS needed, RECOMMENDED) ✓ Tested & Working
# paraformer-v2: Async task-based (requires Ngrok for public HTTPS URL) ⚠️ Needs setup
VIDEO_CUT_ASR_MODEL=paraformer-realtime-v2

# --- Ngrok Configuration (for paraformer-v2 only) ---
# Get your auth token from https://dashboard.ngrok.com/get-started/your-authtoken
# This creates a public HTTPS URL for local audio files
# VIDEO_CUT_NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# --- LLM Model ---
VIDEO_CUT_LLM_MODEL=qwen-max
